# Web Frontend Environment Variables
# Copy this file to .env.local for local development
# Set VITE_API_URL in Render Dashboard → Environment for production

# Backend API base URL (include /api/v1 at the end)
# Local development (default if not set):
#   http://localhost:5000/api/v1
# Production (set this in Render Dashboard):
#   https://your-backend-name.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
