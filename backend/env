# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
# Lưu ý: Prisma với MongoDB yêu cầu Replica Set để sử dụng Transactions. 
# Trong môi trường dev Docker, link này sẽ hoạt động trực tiếp.
DATABASE_URL="mongodb://admin:password@localhost:27017/ielts_app?authSource=admin"

# Auth
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=30d

# AI Integration
OPENAI_API_KEY=your_openai_key
