# Server Configuration
PORT=5000
NODE_ENV=development

# Database — MongoDB (Prisma connection string with Replica Set for Prisma compatibility)
DATABASE_URL="mongodb://admin:password@localhost:27017/ielts_app?authSource=admin&replicaSet=rs0&directConnection=true"

# Redis — Used for booking concurrency lock (Epic 4)
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# AI Integration (Epic 3)
OPENAI_API_KEY=your_openai_api_key_here

# Email (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

GOOGLE_CLIENT_ID=your_google_client_id_here
